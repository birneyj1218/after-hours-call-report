# Copy to .env and fill in. Never commit .env.
# Defaults point every provider at the local mock server (npm run mock), so the whole
# flow runs without real accounts. Secrets (API keys, tokens) are NOT set here: they go
# in n8n credentials, referenced by name in the workflow (see README).

# ---- Business
BUSINESS_NAME=Cavern Electrical
# IANA zone; the digest groups calls by night in this zone. Also set the workflow's
# Settings > Timezone to the same value so the 7:00 digest runs at 7:00 local.
BUSINESS_TIMEZONE=America/Chicago
OWNER_EMAIL=owner@example.com
REPORT_FROM_EMAIL=after-hours@example.com
OWNER_SMS_NUMBER=+16125550100

# ---- When to alert the owner right away (every call is in the morning digest)
# SMS_ALERT_LEVEL: emergency | urgent | none
SMS_ALERT_LEVEL=emergency
# EMAIL_EACH_CALL: emergency | urgent | all | none
EMAIL_EACH_CALL=emergency
# "No heat" plus a stated temperature at or below this (F) counts as an emergency
FREEZING_TEMP_F=40
# Calls ending before this local hour belong to the previous night
NIGHT_CUTOVER_HOUR=12
SEND_EMPTY_DIGEST=true

# ---- LLM (any OpenAI-compatible /chat/completions endpoint, including a local one)
LLM_ENABLED=true
LLM_BASE_URL=http://host.docker.internal:4010/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000

# ---- Email API (JSON body: from, to, subject, html, text)
EMAIL_API_URL=http://host.docker.internal:4010/emails

# ---- SMS (Twilio-style API)
SMS_BASE_URL=http://host.docker.internal:4010
SMS_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMS_FROM_NUMBER=+16125550199

# ---- CRM / ticket system webhook
CRM_WEBHOOK_URL=http://host.docker.internal:4010/crm/calls

# Optional line printed at the bottom of every report
REPORT_FOOTNOTE=

# Real endpoints when you go live (examples):
#   LLM_BASE_URL=https://api.openai.com/v1
#   EMAIL_API_URL=https://api.resend.com/emails
#   SMS_BASE_URL=https://api.twilio.com

# ---- mock server (npm run mock); 0.0.0.0 so the n8n container can reach it
HOST=0.0.0.0
PORT=4010

# ---- mock/send-call.js (fake voice provider)
VOICE_WEBHOOK_HEADER=X-Vapi-Secret
VOICE_WEBHOOK_SECRET=pick-a-long-random-string

# ---- n8n container
N8N_ENCRYPTION_KEY=generate-a-long-random-string
GENERIC_TIMEZONE=America/Chicago
